/*
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.misereperdue.com wss://api.misereperdue.com; frame-src https://www.youtube.com https://open.spotify.com https://w.soundcloud.com https://player.vimeo.com; frame-ancestors 'none'

# Repo-only folders (docs, readable sources, tooling, worker backup) are
# served by Pages too, because the whole repo is the site. Keep them out of search.
/docs/*
  X-Robots-Tag: noindex, nofollow
/src/*
  X-Robots-Tag: noindex, nofollow
/tools/*
  X-Robots-Tag: noindex, nofollow
/worker/*
  X-Robots-Tag: noindex, nofollow
