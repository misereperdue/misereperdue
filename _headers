# Versioned / immutable assets (?v= pins or versioned path). No "no-cache" here.
/js/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/css/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# Emoji image sets (js/emoji.js): a set folder never changes (new art = new folder).
/emoji/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# Images/video are not always pinned: cache a day, refresh in the background.
/img/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/video/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Keep the pages.dev copies (production alias + previews) out of search.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

